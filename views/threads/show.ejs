<!-- views/threads/show.ejs — Thread Detail with Messages -->

<!-- Breadcrumb -->
<nav class="flex items-center gap-2 text-sm text-slate-400 mb-8">
  <a href="/projects" class="hover:text-black transition-colors">Projects</a>
  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
  </svg>
  <a href="/projects/<%= projectId %>" class="hover:text-black transition-colors"><%= project.name %></a>
  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
  </svg>
  <span class="text-slate-900 font-medium truncate max-w-xs"><%= thread.title %></span>
</nav>

<!-- Thread Header -->
<div class="card p-8 mb-6">
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
          </svg>
        </div>
        <span class="text-xs font-medium text-indigo-600 uppercase tracking-wider">Discussion</span>
      </div>
      <h1 class="text-2xl font-semibold text-slate-900 mb-2"><%= thread.title %></h1>
      <p class="text-sm text-slate-500">
        Started by
        <strong class="text-slate-700"><%= thread.creator ? thread.creator.username : 'unknown' %></strong>
        · <%= new Date(thread.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
        · <strong class="text-slate-700"><%= thread.messages ? thread.messages.length : 0 %></strong> message<%= (thread.messages && thread.messages.length === 1) ? '' : 's' %>
      </p>
    </div>
    <!-- Admin actions -->
    <% if (isProjectAdmin) { %>
      <div class="flex items-center gap-2 flex-shrink-0">
        <a href="/projects/<%= projectId %>/threads/<%= thread.id %>/edit"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium
                 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit
        </a>
        <form action="/projects/<%= projectId %>/threads/<%= thread.id %>?_method=DELETE" method="POST"
          onsubmit="return confirm('Delete this entire thread and all messages?')">
          <button type="submit"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium btn-danger">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Delete
          </button>
        </form>
      </div>
    <% } %>
  </div>
</div>

<!-- ─── Messages ────────────────────────────────────────────── -->
<div class="space-y-4 mb-6">
  <% if (thread.messages && thread.messages.length > 0) { %>
    <% thread.messages.forEach(msg => { %>
      <%
        const isOwnMessage = currentUser && msg.userId === currentUser.id;
        const canModify    = isOwnMessage || (currentUser && currentUser.role === 'admin');
      %>
      <div class="card p-6" id="message-<%= msg.id %>">
        <div class="flex items-start gap-4">
          <!-- Avatar -->
          <div class="w-9 h-9 rounded-full bg-slate-100 border border-slate-200
                      flex items-center justify-center text-sm font-semibold text-slate-600 flex-shrink-0">
            <%= msg.author ? msg.author.username.charAt(0).toUpperCase() : '?' %>
          </div>

          <!-- Content -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-3 mb-2">
              <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-slate-900">
                  <%= msg.author ? msg.author.username : 'Unknown user' %>
                </span>
                <span class="text-xs text-slate-400">
                  <%= new Date(msg.createdAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </span>
                <% if (msg.updatedAt && msg.updatedAt !== msg.createdAt) { %>
                  <span class="text-xs text-slate-400 italic">(edited)</span>
                <% } %>
              </div>
              <!-- Edit / Delete -->
              <% if (canModify) { %>
                <div class="flex items-center gap-1 flex-shrink-0">
                  <a href="/projects/<%= projectId %>/threads/<%= thread.id %>/messages/<%= msg.id %>/edit"
                    class="p-1.5 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors"
                    title="Edit message">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  </a>
                  <form action="/projects/<%= projectId %>/threads/<%= thread.id %>/messages/<%= msg.id %>?_method=DELETE"
                    method="POST" onsubmit="return confirm('Delete this message?')">
                    <button type="submit"
                      class="p-1.5 rounded text-slate-400 hover:text-red-500 hover:bg-red-50 transition-colors"
                      title="Delete message">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </form>
                </div>
              <% } %>
            </div>

            <!-- Message body -->
            <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-wrap"><%= msg.body %></p>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="card px-8 py-12 text-center text-slate-400 text-sm">
      No messages yet. Be the first to post!
    </div>
  <% } %>
</div>

<!-- ─── Post a Message ──────────────────────────────────────── -->
<div class="card p-6">
  <h2 class="text-sm font-semibold text-slate-700 mb-4">Post a Message</h2>
  <form action="/projects/<%= projectId %>/threads/<%= thread.id %>/messages" method="POST" class="space-y-4">
    <div>
      <label for="body" class="sr-only">Your message</label>
      <textarea id="body" name="body" rows="4" required
        class="input-field w-full rounded-md px-4 py-3 text-sm resize-none"
        placeholder="Write your message…"></textarea>
    </div>
    <div class="flex items-center gap-3">
      <button type="submit" id="post-message-btn"
        class="btn-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-md text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
        Post Message
      </button>
    </div>
  </form>
</div>
