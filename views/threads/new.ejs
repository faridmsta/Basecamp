<!-- views/threads/new.ejs — New Thread Form -->

<a href="/projects/<%= projectId %>"
  class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-black transition-colors mb-8">
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
  </svg>
  Back to Project
</a>

<div class="max-w-2xl mx-auto">
  <div class="card p-8">
    <div class="flex items-center gap-3 mb-8">
      <div class="w-10 h-10 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
        </svg>
      </div>
      <div>
        <h1 class="text-xl font-semibold text-slate-900">New Discussion Thread</h1>
        <p class="text-sm text-slate-500"><%= project.name %></p>
      </div>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md">
        <% errors.forEach(e => { %>
          <p class="text-sm text-red-700"><%= e.message %></p>
        <% }) %>
      </div>
    <% } %>

    <form action="/projects/<%= projectId %>/threads" method="POST" class="space-y-6">
      <div>
        <label for="title" class="block text-sm font-medium text-slate-700 mb-2">Thread Title</label>
        <input type="text" id="title" name="title" required
          class="input-field w-full rounded-md px-4 py-2.5 text-sm"
          placeholder="e.g. Design feedback for Q3" />
      </div>
      <div class="flex items-center gap-3 pt-2">
        <button type="submit" id="create-thread-btn"
          class="btn-primary inline-flex items-center gap-2 px-6 py-2.5 rounded-md text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Create Thread
        </button>
        <a href="/projects/<%= projectId %>"
          class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Cancel</a>
      </div>
    </form>
  </div>
</div>
