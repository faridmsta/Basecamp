<nav class="glass sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Brand -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="font-bold text-slate-900 text-lg tracking-tight group-hover:text-slate-600 transition-colors">
          Project Manager
        </span>
      </a>

      <!-- Nav Links -->
      <div class="flex items-center gap-4">
        <% if (currentUser) { %>

          <a href="/projects"
            class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">
            Projects
          </a>

          <a href="/users/<%= currentUser.id %>"
            class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">
            Profile
          </a>

          <% if (currentUser.role==='admin' ) { %>
            <a href="/admin/users"
              class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Admin
            </a>
            <% } %>

              <!-- Sign Out -->
              <form action="/sessions/sign_out?_method=DELETE" method="POST" class="ml-4">
                <button type="submit" class="text-sm font-medium text-red-600 hover:text-red-700 transition-colors">
                  Sign Out
                </button>
              </form>

              <% } else { %>

                <a href="/sessions/sign_in"
                  class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">
                  Sign In
                </a>

                <a href="/users/new"
                  class="ml-4 px-4 py-2 rounded-md text-sm font-medium btn-primary">
                  Get Started
                </a>

                <% } %>
      </div>

    </div>
  </div>
</nav>