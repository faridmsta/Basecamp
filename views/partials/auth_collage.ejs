<!-- views/partials/auth_collage.ejs -->
<div class="collage-grid" style="padding: 10px; background: #111827; height: 100vh;">

  <!-- Row 1 -->
  <!-- Cell (1,1): Orange stat card -->
  <div class="collage-cell" style="grid-column:1; grid-row:1;">
    <div class="stat-card stat-card-orange" style="justify-content:flex-end;">
      <div class="stat-number">41%</div>
      <div class="stat-text">of recruiters say entry-level positions are the hardest to fill.</div>
    </div>
  </div>

  <!-- Cell (1,2): Photo - person working -->
  <div class="collage-cell" style="grid-column:2; grid-row:1;">
    <img
      src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=400&q=80"
      alt="Professional working"
    />
  </div>

  <!-- Cell (1,3): Photo - architecture -->
  <div class="collage-cell" style="grid-column:3; grid-row:1;">
    <img
      src="https://images.unsplash.com/photo-1486325212027-8081e485255e?w=400&q=80"
      alt="Modern architecture"
    />
  </div>

  <!-- Row 2 -->
  <!-- Cell (2,1): Photo - person at laptop -->
  <div class="collage-cell" style="grid-column:1; grid-row:2;">
    <img
      src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=400&q=80"
      alt="Person at laptop"
    />
  </div>

  <!-- Cell (2,2): Photo - professional woman smiling -->
  <div class="collage-cell" style="grid-column:2; grid-row:2;">
    <img
      src="https://images.unsplash.com/photo-1580489944761-15a19d654956?w=400&q=80"
      alt="Professional woman"
    />
  </div>

  <!-- Cell (2,3): Photo - desk setup -->
  <div class="collage-cell" style="grid-column:3; grid-row:2;">
    <img
      src="https://images.unsplash.com/photo-1593642632823-8f785ba67e45?w=400&q=80"
      alt="Desk setup"
    />
  </div>

  <!-- Row 3 -->
  <!-- Cell (3,1): Photo - team meeting -->
  <div class="collage-cell" style="grid-column:1; grid-row:3;">
    <img
      src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=400&q=80"
      alt="Team collaboration"
    />
  </div>

  <!-- Cell (3,2): Green stat card -->
  <div class="collage-cell" style="grid-column:2; grid-row:3;">
    <div class="stat-card stat-card-green" style="justify-content:flex-end;">
      <div class="stat-number">76%</div>
      <div class="stat-text">of hiring managers admit attracting the right job candidates is their greatest challenge.</div>
    </div>
  </div>

  <!-- Cell (3,3): Photo - office space -->
  <div class="collage-cell" style="grid-column:3; grid-row:3;">
    <img
      src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=400&q=80"
      alt="Modern office"
    />
  </div>

</div>
