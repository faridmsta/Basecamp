<!-- views/projects/index.ejs — Project Dashboard -->

<!-- Page Header -->
<div class="flex flex-col sm:flex-col sm:items-start justify-between gap-4 mb-10">
  <div>
    <h1 class="text-3xl font-bold text-black">Projects</h1>
    <p class="text-slate-400 mt-1">
      <% if (currentUser && currentUser.role==='admin' ) { %>
        All projects across the platform
        <% } else { %>
          Your active workspaces
          <% } %>
    </p>
  </div>
  <a href="/projects/new" id="new-project-btn"
    class="btn-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-md text-white font-medium text-sm">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    New Project
  </a>
</div>

<!-- Stats Bar -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
  <div class="card p-6">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Total Projects</p>
    <p class="text-3xl font-semibold text-slate-900">
      <%= projects.length %>
    </p>
  </div>
  <div class="card p-6">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Active</p>
    <p class="text-3xl font-semibold text-emerald-600">
      <%= projects.filter(p=> p.status === 'active').length %>
    </p>
  </div>
  <div class="card p-6">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Completed</p>
    <p class="text-3xl font-semibold text-blue-600">
      <%= projects.filter(p=> p.status === 'completed').length %>
    </p>
  </div>
</div>

<!-- Project Grid -->
<% if (projects.length===0) { %>
  <!-- Empty State -->
  <div class="card p-16 text-center">
    <div
      class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 border border-slate-200 mb-6">
      <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M3 7a2 2 0 012-2h4l2 3H3V7zm0 4h18M5 11v8a2 2 0 002 2h10a2 2 0 002-2v-8" />
      </svg>
    </div>
    <h2 class="text-lg font-medium text-slate-900 mb-2">No projects yet</h2>
    <p class="text-slate-500 mb-6">Create your first project to get started.</p>
    <a href="/projects/new"
      class="btn-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-md text-white font-medium text-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Create Project
    </a>
  </div>

  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <% projects.forEach(project=> { %>
        <a href="/projects/<%= project.id %>" class="card p-6 block hover:border-slate-400 transition-colors group">

          <!-- Status Badge -->
          <div class="flex items-center justify-between mb-4">
            <span class="status-<%= project.status %> text-xs font-medium px-2.5 py-1 rounded-md capitalize">
              <%= project.status %>
            </span>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none"
              stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>

          <!-- Project Name -->
          <h2 class="text-lg font-medium text-slate-900 group-hover:text-slate-700 transition-colors mb-2 line-clamp-1">
            <%= project.name %>
          </h2>

          <!-- Description -->
          <p class="text-sm text-slate-500 line-clamp-2 min-h-[2.5rem]">
            <%= project.description || 'No description provided.' %>
          </p>

          <!-- Footer -->
          <div class="flex items-center justify-between mt-5 pt-4 border-t border-slate-100">
            <span class="text-xs text-slate-500">
              <% if (currentUser && currentUser.role==='admin' && project.owner) { %>
                By <span class="font-medium text-slate-700">
                  <%= project.owner.username %>
                </span>
                <% } else { %>
                  <%= new Date(project.createdAt).toLocaleDateString('en-US', { month: 'short' , day: 'numeric' ,
                    year: 'numeric' }) %>
                    <% } %>
            </span>
            <span class="text-xs text-slate-400">
              Updated <%= new Date(project.updatedAt).toLocaleDateString() %>
            </span>
          </div>
        </a>
        <% }) %>
    </div>
    <% } %>