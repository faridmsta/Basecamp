<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="Project Manager Application — A powerful project management tool for modern teams." />
  <title>
    <%= title %> | Project Manager Application
  </title>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet" />

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] },
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
            },
          },
          animation: {
            'fade-in': 'fadeIn 0.5s ease-out both',
            'slide-up': 'slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) both',
          },
          keyframes: {
            fadeIn: { from: { opacity: '0' }, to: { opacity: '1' } },
            slideUp: { from: { opacity: '0', transform: 'translateY(12px)' }, to: { opacity: '1', transform: 'translateY(0)' } },
          },
        },
      },
    };
  </script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    /* Clean Solid Styles (Replaces Glass) */
    .glass {
      background-color: #ffffff;
      border-bottom: 1px solid #e2e8f0;
    }

    /* Buttons: Solid, flat, sharp */
    .btn-primary {
      background-color: #0f172a;
      color: #ffffff;
      font-weight: 500;
      border: 1px solid #0f172a;
      transition: all 0.15s ease-in-out;
    }

    .btn-primary:hover {
      background-color: #1e293b;
      border-color: #1e293b;
    }

    /* Buttons: Secondary/Danger */
    .btn-danger {
      background-color: #ffffff;
      color: #ef4444;
      font-weight: 500;
      border: 1px solid #fca5a5;
      transition: all 0.15s ease-in-out;
    }

    .btn-danger:hover {
      background-color: #fef2f2;
      border-color: #ef4444;
    }

    /* Inputs: Strict and clean */
    .input-field {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      color: #0f172a;
      transition: all 0.15s ease-in-out;
    }

    .input-field:focus {
      border-color: #0f172a;
      outline: none;
      box-shadow: 0 0 0 1px #0f172a;
    }

    /* Cards: Clean 1px borders, generous padding, soft shadow */
    .card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      border-radius: 0.5rem;
    }

    /* Status Badges: Clean, solid, accessible */
    .status-active {
      background: #f0fdf4;
      color: #166534;
      border: 1px solid #bbf7d0;
    }

    .status-archived {
      background: #f8fafc;
      color: #475569;
      border: 1px solid #e2e8f0;
    }

    .status-completed {
      background: #eff6ff;
      color: #1e40af;
      border: 1px solid #bfdbfe;
    }
  </style>
</head>

<body class="h-full text-slate-900 antialiased">

  <!-- ── Navigation ────────────────────────────────────── -->
  <%- include('../partials/navbar') %>

    <!-- ── Flash Messages ───────────────────────────────── -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <% if (successMessages && successMessages.length> 0) { %>
        <% successMessages.forEach(msg=> { %>
          <div
            class="animate-slide-up flex items-center gap-3 mb-3 px-4 py-3 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium shadow-sm">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <%= msg %>
          </div>
          <% }) %>
            <% } %>

              <% if (errorMessages && errorMessages.length> 0) { %>
                <% errorMessages.forEach(msg=> { %>
                  <div
                    class="animate-slide-up flex items-center gap-3 mb-3 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm font-medium shadow-sm">
                    <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <%= msg %>
                  </div>
                  <% }) %>
                    <% } %>
    </div>

    <!-- ── Main Content ──────────────────────────────────── -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 animate-fade-in">
      <%- body %>
    </main>

    <!-- ── Footer ────────────────────────────────────────── -->
    <footer class="border-t border-slate-200 mt-auto py-12 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="text-slate-500 text-sm">
          &copy; <%= new Date().getFullYear() %> <span class="font-medium text-slate-900">Project Manager
              Application</span>
        </div>
        <div class="flex gap-8 text-sm text-slate-500 font-medium">
          <a href="#" class="hover:text-slate-900 transition-colors">Privacy Policy</a>
          <a href="#" class="hover:text-slate-900 transition-colors">Terms of Service</a>
        </div>
      </div>
    </footer>

</body>

</html>